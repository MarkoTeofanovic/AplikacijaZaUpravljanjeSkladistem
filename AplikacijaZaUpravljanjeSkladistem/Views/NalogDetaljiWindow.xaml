<Window x:Class="AplikacijaZaUpravljanjeSkladistem.Views.NalogDetaljiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Novi nalog" Height="500" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="12">
        <TextBlock Text="Tip naloga"/>
        <ComboBox ItemsSource="{Binding Tipovi}" SelectedItem="{Binding Tip}" Margin="0,2,0,10"/>

        <TextBlock Text="Broj naloga"/>
        <TextBox Text="{Binding BrojNaloga, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>

        <TextBlock Text="Dobavljac / Primalac"/>
        <TextBox Text="{Binding Partner, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>

        <TextBlock Text="Stavke" FontWeight="Bold" Margin="0,4,0,4"/>

        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" ItemsSource="{Binding Proizvodi}" DisplayMemberPath="Naziv"
                      SelectedItem="{Binding IzabranProizvod}" Margin="0,0,4,0"/>
            <TextBox Grid.Column="1" Text="{Binding KolicinaZaDodavanje, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0"/>
            <Button Grid.Column="2" Content="Dodaj" Command="{Binding DodajStavkuCommand}"/>
        </Grid>

        <DataGrid ItemsSource="{Binding Stavke}" SelectedItem="{Binding IzabranaStavka}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="120" Margin="0,0,0,6">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Proizvod" Binding="{Binding Proizvod.Naziv}" Width="*"/>
                <DataGridTextColumn Header="Kolicina" Binding="{Binding Kolicina}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Content="Ukloni stavku" HorizontalAlignment="Left" Width="100"
                Command="{Binding UkloniStavkuCommand}" Margin="0,0,0,10"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Otkazi" Width="80" Margin="0,0,8,0" Command="{Binding OtkaziCommand}"/>
            <Button Content="Sacuvaj" Width="80" Command="{Binding SacuvajCommand}"/>
        </StackPanel>
    </StackPanel>
</Window>
