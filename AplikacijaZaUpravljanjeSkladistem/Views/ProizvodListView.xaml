<UserControl x:Class="AplikacijaZaUpravljanjeSkladistem.Views.ProizvodListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Dodaj" Width="80" Margin="4,0,0,0" Command="{Binding DodajCommand}"/>
                <Button Content="Izmeni" Width="80" Margin="4,0,0,0" Command="{Binding IzmeniCommand}"/>
                <Button Content="Obrisi" Width="80" Margin="4,0,0,0" Command="{Binding ObrisiCommand}"/>
            </StackPanel>
            <TextBlock Text="Pretraga:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox Text="{Binding Pretraga, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
        </DockPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Proizvodi}" SelectedItem="{Binding Izabran}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Naziv" Binding="{Binding Naziv}" Width="*"/>
                <DataGridTextColumn Header="Sifra" Binding="{Binding Sifra}" Width="100"/>
                <DataGridTextColumn Header="Kategorija" Binding="{Binding Kategorija.Naziv}" Width="150"/>
                <DataGridTextColumn Header="Cena" Binding="{Binding Cena}" Width="80"/>
                <DataGridTextColumn Header="Kolicina" Binding="{Binding KolicinaNaStanju}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
